# Copy to .env and fill in. Never commit .env.

# Alpaca paper trading (free account: https://alpaca.markets)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# SEC EDGAR fair-access identity (required by edgartools.set_identity)
# Format: "Name email@example.com"
SEC_IDENTITY=

# Optional: Tiingo free API key (data-quality upgrade over yfinance)
TIINGO_API_KEY=
